# Copy to .env.local. Required: DATABASE_URL, BETTER_AUTH_SECRET, BETTER_AUTH_URL, NEXT_PUBLIC_APP_URL.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/linkpositively
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# log = SMS/email written to the server log; live = actually sent (production only)
DELIVERY_MODE=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMTP_URL=
MAIL_FROM=

# Without these, uploads go to ./.data/uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

QUALTRICS_API_TOKEN=
QUALTRICS_DATA_CENTER=
TECHSTEP_SSO_SECRET=
GOOGLE_MAPS_API_KEY=

# AI Coach / voice / video
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=
ANAM_API_KEY=

LOG_LEVEL=info
