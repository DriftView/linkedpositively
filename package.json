    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "db": "tsx scripts/dev-db.mts",
    "db:stop": "tsx scripts/dev-db.mts stop",
