    "db:migrate": "tsx scripts/migrate-db.mts",
    "db:studio": "drizzle-kit studio",
    "migrate:legacy": "tsx --env-file=.env --conditions=react-server scripts/migrate/index.mts",
    "migrate:verify": "tsx --env-file=.env --conditions=react-server scripts/migrate/verify.mts",
    "seed": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local --conditions=react-server scripts/seed.mts",
    "jobs": "inngest-cli dev -u http://localhost:3000/api/inngest"
  },
